# =============================================================================
#  Environment variables for docker-compose.
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to source control.
# =============================================================================

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password_change_me
DB_NAME=slotsync_dev
DB_USERNAME=slotsync
DB_PASSWORD=slotsync_password_change_me

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a cryptographically random 256-bit key for production
# Example: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-a-real-256-bit-secret-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true and fill credentials to enable email notifications.
# If left as false, the app works without email (notifications via WebSocket/DB only).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
